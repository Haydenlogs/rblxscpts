--------------------------------------------------
-- STOP EMOTES
--------------------------------------------------

local function stopAllEmotes()

	if loopingTrack then
		loopingTrack:Stop()
		loopingTrack=nil
	end


	if runningConnection then
		runningConnection:Disconnect()
		runningConnection=nil
	end


	local character =
		player.Character


	if character then

		local humanoid =
			character:FindFirstChild("Humanoid")


		if humanoid then

			local animator =
				humanoid:FindFirstChild("Animator")


			if animator then

				for _,track in pairs(
					animator:GetPlayingAnimationTracks()
				) do
					track:Stop()
				end

			end
		end
	end
end


--------------------------------------------------
-- PLAY ANIMATION
--------------------------------------------------

local function playAnimation(data)

	local character =
		player.Character
		or player.CharacterAdded:Wait()


	local humanoid =
		character:WaitForChild("Humanoid")


	local animator =
		humanoid:WaitForChild("Animator")


	stopAllEmotes()


	local animation =
		Instance.new("Animation")


	animation.AnimationId =
		data.Id


	local track =
		animator:LoadAnimation(animation)


	track.Priority =
		Enum.AnimationPriority.Action


	track.Looped =
		data.Loop


	track:Play()


	if data.Loop then

		loopingTrack =
			track


		runningConnection =
			humanoid.Running:Connect(function(speed)

				if speed > 0 then
					stopAllEmotes()
				end

			end)

	end
end


