--------------------------------------------------
-- ROBLOX ECONOMY API LOOKUP
--------------------------------------------------

local function getAssetInfo(id)

	local info = {
		Name = "Unknown Animation",
		Creator = "Unknown Creator"
	}

	local success,response = pcall(function()

		return game:HttpGet(
			"https://economy.roblox.com/v2/assets/"
			..id..
			"/details"
		)

	end)


	if success then

		local data =
			HttpService:JSONDecode(response)


		info.Name =
			data.Name or info.Name

		print(info.Name.." successfully loaded ("..id..")")
		if data.Creator then
			info.Creator =
				data.Creator.Name or info.Creator
		end

	end

	return info
end


